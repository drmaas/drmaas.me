---
import config from "src/config";
import NavListItem from "./NavListItem.astro";
import ThemeIcon from "./ThemeIcon.astro";

export interface Props {
  activeLink: string;
}

const { activeLink } = Astro.props as Props;
const {
  metaData: { fullName },
  navLinks,
} = config;
---

<div
  id="nav-backdrop"
  class="nav-backdrop"
  hidden
  aria-hidden="true"
  tabindex="-1"
></div>

<label
  aria-label="Hamburger Menu"
  id="nav-toggle"
  class="btn btn-circle swap swap-rotate fixed z-999 top-4 right-4 hidden"
  aria-controls="primary-nav"
  aria-expanded="false"
>
  <input type="checkbox" />
  <!-- hamburger icon -->
  <svg
    class="swap-off fill-current"
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    viewBox="0 0 512 512"
  >
    <path
      d="M64,384H448V341.33H64Zm0-106.67H448V234.67H64ZM64,128v42.67H448V128Z"
    ></path>
  </svg>
  <!-- close icon -->
  <svg
    class="swap-on fill-current"
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    viewBox="0 0 512 512"
  >
    <polygon
      points="400 145.49 366.51 112 256 222.51 145.49 112 112 145.49 222.51 256 112 366.51 145.49 400 256 289.49 366.51 400 400 366.51 289.49 256 400 145.49"
    ></polygon>
  </svg>
</label>

<nav class="mr-6" aria-label="Primary navigation">
  <ul
    id="primary-nav"
    class="flex gap-8 items-center justify-center z-100"
    data-visible="false"
  >
    {
      navLinks.map((ele) => (
        <NavListItem
          navLink={ele.link}
          text={ele.text ?? ""}
          activeLink={activeLink ?? ""}
          icon={ele.icon}
          absolute={ele.absolute ?? false}
          tip={ele.tip}
        />
      ))
    }
    <ThemeIcon />
  </ul>
</nav>

<style>
  /* Mobile Navigation */
  @media (max-width: 640px) {
    .nav-backdrop {
      position: fixed;
      inset: 0;
      z-index: 99;
      border: none;
      padding: 0;
      margin: 0;
      background: hsl(var(--bc) / 0.15);
      cursor: pointer;
    }

    ul#primary-nav {
      position: fixed;
      inset: 0 0 0 30%;
      flex-direction: column;
      padding: min(30vh, 10rem) 2em;
      transform: translateX(100%);
      transition: transform 500ms ease-in-out;
      background: hsl(var(--hamburger-bg) / 0.5);
      backdrop-filter: blur(2rem);
    }

    ul#primary-nav[data-visible="true"] {
      transform: translateX(0);
    }

    @media (prefers-reduced-motion: reduce) {
      ul#primary-nav {
        transition: none;
      }
    }

    label#nav-toggle {
      display: grid;
    }
  }

  /* Logo & Theme SVG color */
  header path {
    fill: hsl(var(--fill-color));
  }
  header polygon {
    fill: hsl(var(--er));
  }

  /* Logo Animation */
  header > div > svg > path {
    stroke-dasharray: var(--svg-totalLength);
    stroke-dashoffset: var(--svg-totalLength);
    animation: logoAnimation 5s forwards ease-in-out;
    paint-order: stroke;
  }

  @keyframes logoAnimation {
    from {
      fill: hsl(var(--fill-color) / 0.1);
      stroke: hsl(var(--stroke-color));
    }

    to {
      stroke-dashoffset: 0;
      fill: hsl(var(--fill-color));
      stroke: hsl(var(--stroke-color) / 0);
    }
  }
</style>

<script>
  const MOBILE_NAV_QUERY = "(max-width: 640px)";
  const FOCUSABLE_SELECTOR =
    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  function setupMobileNav() {
    const nav = document.querySelector<HTMLUListElement>("#primary-nav");
    const navToggle = document.querySelector<HTMLLabelElement>("#nav-toggle");
    const navToggleInput =
      document.querySelector<HTMLInputElement>("#nav-toggle input");
    const backdrop = document.querySelector<HTMLDivElement>("#nav-backdrop");
    const main = document.querySelector<HTMLElement>("main");
    const footer = document.querySelector<HTMLElement>("footer");
    const scrollButton =
      document.querySelector<HTMLElement>("#scrollButton");
    const skipLink = document.querySelector<HTMLElement>('a[href="#main"]');
    const siteBrand = document.querySelector<HTMLElement>("header > div.min-w-0");

    if (!nav || !navToggle || !navToggleInput || !backdrop) {
      return;
    }

    const inertTargets = [main, footer, scrollButton, skipLink, siteBrand].filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );

    if (navToggleInput.dataset.navBound === "true") {
      return;
    }
    navToggleInput.dataset.navBound = "true";

    let trapKeydown: ((event: KeyboardEvent) => void) | null = null;

    const isMobileNav = () =>
      window.matchMedia(MOBILE_NAV_QUERY).matches;

    const getDrawerFocusables = (): HTMLElement[] =>
      Array.from(nav.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR)).filter(
        (el) => !el.closest("[hidden]"),
      );

    const getTrapFocusables = (): HTMLElement[] => {
      const drawer = getDrawerFocusables();
      return drawer.length > 0 ? [...drawer, navToggle] : [navToggle];
    };

    const setInertBackground = (inert: boolean) => {
      for (const el of inertTargets) {
        if (inert) {
          el.setAttribute("inert", "");
          el.setAttribute("aria-hidden", "true");
        } else {
          el.removeAttribute("inert");
          el.removeAttribute("aria-hidden");
        }
      }
    };

    const removeTrap = () => {
      if (trapKeydown) {
        document.removeEventListener("keydown", trapKeydown);
        trapKeydown = null;
      }
    };

    const closeMenu = (returnFocus = true) => {
      nav.setAttribute("data-visible", "false");
      navToggle.setAttribute("aria-expanded", "false");
      navToggleInput.checked = false;
      backdrop.hidden = true;
      backdrop.setAttribute("aria-hidden", "true");
      setInertBackground(false);
      removeTrap();
      if (returnFocus) {
        navToggle.focus();
      }
    };

    const openMenu = () => {
      nav.setAttribute("data-visible", "true");
      navToggle.setAttribute("aria-expanded", "true");
      backdrop.hidden = false;
      backdrop.setAttribute("aria-hidden", "false");
      setInertBackground(true);

      const firstLink = nav.querySelector<HTMLElement>("a[href]");
      (firstLink ?? getDrawerFocusables()[0])?.focus();

      trapKeydown = (event: KeyboardEvent) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closeMenu(true);
          return;
        }

        if (event.key !== "Tab") {
          return;
        }

        const focusables = getTrapFocusables();
        if (focusables.length === 0) {
          return;
        }

        const first = focusables[0];
        const last = focusables.at(-1);
        if (!first || !last) {
          return;
        }

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };

      document.addEventListener("keydown", trapKeydown);
    };

    const syncFromCheckbox = () => {
      if (!isMobileNav()) {
        closeMenu(false);
        return;
      }

      if (navToggleInput.checked) {
        openMenu();
      } else {
        closeMenu(true);
      }
    };

    navToggleInput.addEventListener("change", syncFromCheckbox);

    backdrop.addEventListener("click", () => {
      closeMenu(true);
    });

    window.matchMedia(MOBILE_NAV_QUERY).addEventListener("change", (event) => {
      if (!event.matches && nav.getAttribute("data-visible") === "true") {
        closeMenu(false);
      }
    });
  }

  setupMobileNav();
  document.addEventListener("astro:page-load", setupMobileNav);
</script>
