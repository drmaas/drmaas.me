<!-- Theme, Light/Dark mode -->
<li
  class="after:block after:mx-auto after:h-[0.15em] after:bottom-0 after:w-0 after:bg-green-700 dark:after:bg-amber-400 after:transition-[all_ease_in_out_300ms] after:mt-1 hover:after:w-full"
>
  <label id="themeSetting" class="swap swap-rotate w-6 h-6">
    <input type="checkbox" role="switch" aria-label="Dark mode" aria-checked="false" />
    <!-- moon icon (dark mode on) -->
    <svg
      class="swap-on fill-current w-6 h-6"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"
      ></path>
    </svg>
    <!-- sun icon (light mode) -->
    <svg
      class="swap-off fill-current w-6 h-6"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
      ></path>
    </svg>
  </label>
  <span id="theme-status" class="sr-only" aria-live="polite"></span>
</li>

<style>
  html[data-theme="night"] {
    --fill-color: 142 72% 29%;
    --stroke-color: 217 33% 17%;
    --hamburger-bg: 0 0% 30%;
    color-scheme: dark;
  }

  html[data-theme="cmyk"] {
    --fill-color: 173 80% 40%;
    --stroke-color: 213 27% 84%;
    --hamburger-bg: 0 0% 70%;
    color-scheme: light;
  }
</style>

<script>
  let themeToggleAbort: AbortController | undefined;

  function getThemeInput() {
    return document.querySelector<HTMLInputElement>("#themeSetting > input");
  }

  function getCurrentTheme(): "cmyk" | "night" {
    const html = document.querySelector("html");
    const fromDom = html?.getAttribute("data-theme");
    if (fromDom === "night" || fromDom === "cmyk") {
      return fromDom;
    }
    const stored = localStorage.getItem("theme");
    if (stored === "night" || stored === "cmyk") {
      return stored;
    }
    return "cmyk";
  }

  function syncThemeSwitch(theme: "cmyk" | "night") {
    const html = document.querySelector("html");
    if (html) {
      html.setAttribute("data-theme", theme);
    }

    const input = getThemeInput();
    const isDark = theme === "night";
    if (input) {
      input.checked = isDark;
      input.setAttribute("aria-checked", isDark ? "true" : "false");
    }
  }

  function announceThemeStatus(theme: "cmyk" | "night") {
    const status = document.querySelector("#theme-status");
    if (status) {
      status.textContent = theme === "night" ? "Dark" : "Light";
    }
  }

  function setTheme() {
    syncThemeSwitch(getCurrentTheme());
  }

  function initThemeToggle() {
    themeToggleAbort?.abort();
    themeToggleAbort = new AbortController();
    const { signal } = themeToggleAbort;

    const input = getThemeInput();
    if (!input) {
      return;
    }

    input.addEventListener(
      "change",
      () => {
        const newTheme = input.checked ? "night" : "cmyk";
        localStorage.setItem("theme", newTheme);
        syncThemeSwitch(newTheme);
        announceThemeStatus(newTheme);
      },
      { signal },
    );
  }

  setTheme();
  initThemeToggle();

  document.addEventListener("astro:after-swap", () => {
    setTheme();
    initThemeToggle();
  });
</script>
