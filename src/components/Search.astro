---

---

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="flex flex-col space-y-6">
        <input
            id="search"
            aria-label="search box"
            type="text"
            placeholder="Search articles..."
            class="input input-bordered input-info w-full max-w-lg mx-auto"
        />
        <p
            id="search-status"
            class="sr-only"
            role="status"
            aria-live="polite"
            aria-atomic="true"
        ></p>
        <div id="results" class="flex flex-col gap-6 w-full">
        </div>
    </div>
</div>

<script>
    import { createSearchFuse } from "../lib/search-fuse";
    import {
        renderSearchResults,
        type SearchResult,
    } from "../lib/search-results";

    const baseSite = import.meta.env.BASE_URL;
    let fuse: ReturnType<typeof createSearchFuse> | undefined;

    async function initSearch() {
        const posts: SearchResult[] = await fetch(
            `${baseSite}search/search.json`,
        ).then((resp) => resp.json());

        fuse = createSearchFuse(posts);
    }

    function performSearch(options?: { announce?: boolean }) {
        const input = document.querySelector<HTMLInputElement>("#search");
        const resultsElement = document.querySelector("#results");
        if (!input || !resultsElement || !fuse) return;

        const query = input.value;
        const resultItems = fuse.search(query).map((r) => r.item);
        const statusElement = document.querySelector<HTMLElement>("#search-status");
        const announce = options?.announce ?? true;
        renderSearchResults(resultsElement as HTMLElement, resultItems, {
            query,
            statusElement,
            announce,
        });
    }

    function maybeFocusSearch(input: HTMLInputElement) {
        const finePointer = window.matchMedia("(pointer: fine)").matches;
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        if (finePointer && !reducedMotion) {
            input.focus({ preventScroll: true });
        }
    }

    async function setupSearch() {
        const input = document.querySelector<HTMLInputElement>("#search");
        if (!input) return;

        await initSearch();
        performSearch({ announce: false });

        if (!input.dataset.searchBound) {
            input.dataset.searchBound = "true";
            input.addEventListener("input", () => performSearch());
            maybeFocusSearch(input);
        }
    }

    document.addEventListener("astro:page-load", setupSearch);
</script>
