---

---

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="flex flex-col space-y-6">
        <input
            id="search"
            aria-label="search box"
            type="text"
            placeholder="Search articles..."
            class="input input-bordered input-info w-full max-w-lg mx-auto"
        />
        <div id="results" class="flex flex-col gap-6 w-full">
        </div>
    </div>
</div>

<script>
    import Fuse from "fuse.js";
    import {
        renderSearchResults,
        type SearchResult,
    } from "../lib/search-results";

    const baseSite = import.meta.env.BASE_URL;
    let fuse: Fuse<SearchResult> | undefined;

    async function initSearch() {
        const posts: SearchResult[] = await fetch(
            `${baseSite}search/search.json`,
        ).then((resp) => resp.json());

        fuse = new Fuse(posts, {
            ignoreLocation: true,
            keys: ["title", "description"],
        });
    }

    function performSearch() {
        const input = document.querySelector<HTMLInputElement>("#search");
        const resultsElement = document.querySelector("#results");
        if (!input || !resultsElement || !fuse) return;

        const resultItems = fuse.search(input.value).map((r) => r.item);
        renderSearchResults(resultsElement as HTMLElement, resultItems);
    }

    function maybeFocusSearch(input: HTMLInputElement) {
        const finePointer = window.matchMedia("(pointer: fine)").matches;
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        if (finePointer && !reducedMotion) {
            input.focus({ preventScroll: true });
        }
    }

    async function setupSearch() {
        const input = document.querySelector<HTMLInputElement>("#search");
        if (!input) return;

        await initSearch();
        performSearch();

        if (!input.dataset.searchBound) {
            input.dataset.searchBound = "true";
            input.addEventListener("input", performSearch);
            maybeFocusSearch(input);
        }
    }

    document.addEventListener("astro:page-load", setupSearch);
</script>
