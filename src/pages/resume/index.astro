                    {c.value}
                  </a>
                ) : (
                  <span>{c.value}</span>
                )
              ))}
            </div>
          </div>
          <div class="flex flex-col items-start md:items-end gap-4 shrink-0">
            <button
              id="download-pdf-btn"
              type="button"
              class="btn btn-primary btn-sm gap-2 shadow-sm pdf-exclude"
              aria-label="Download resume as PDF"
            >
