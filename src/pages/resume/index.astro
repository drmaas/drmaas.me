<script>
  let isProcessing = false;

  async function fetchCounter() {
    const counterEl = document.getElementById("visitor-counter");
    if (!counterEl || isProcessing) return;

    isProcessing = true;
    counterEl.className = "font-mono font-bold tabular-nums transition-all duration-500 text-base-content";

    try {
      const response = await fetch("https://api.drmaas.me/resume/increment", {
        method: "POST",
        headers: { Accept: "application/json", "Content-Type": "application/json" },
        body: JSON.stringify({}),
      });

      const data = await response.json();
      const target = data.counter;

      let current = 0;
      const step = Math.max(1, Math.floor(target / 25));
      const tick = () => {
        current = Math.min(current + step, target);
        counterEl.textContent = current.toLocaleString();
        if (current < target) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    } catch {
      counterEl.textContent = "—";
      counterEl.className = "font-mono tabular-nums text-base-content/20";
    } finally {
      isProcessing = false;
    }
  }

  // astro:page-load fires after every navigation (including the first page load)
  // when ClientRouter is active — this is the correct hook to use.
  document.addEventListener("astro:page-load", fetchCounter);
</script>

<script>
  // Client-side PDF export. Renders #resume-capture to a canvas via html2canvas-pro
  // (the "pro" fork handles Tailwind v4's oklch() colors, which the original
  // html2canvas throws on), then slices the image across US-Letter pages in jsPDF.
  // Libraries are dynamically imported so they aren't bundled into the initial load.
  let pdfBusy = false;

  async function downloadResumePdf() {
    if (pdfBusy) return;
    const btn = document.getElementById("download-pdf-btn");
    const label = btn?.querySelector(".btn-label");
    if (!btn) return;

    pdfBusy = true;
    btn.disabled = true;
    const icon = btn.querySelector<SVGSVGElement>(".pdf-icon");
    const spinner = btn.querySelector<HTMLElement>(".pdf-spinner");
    if (icon) icon.style.display = "none";
    if (spinner) spinner.style.display = "inline-flex";
    const originalText = label?.textContent ?? "Download PDF";
    if (label) label.textContent = "Generating…";

    const target = document.getElementById("resume-capture");
    let wrapper: HTMLDivElement | null = null;

    try {
      if (!target) throw new Error("Resume capture element not found");
      // Bail out silently if layout hasn't happened yet (e.g. button clicked
      // during initial paint). An empty canvas would otherwise produce a blank PDF.
      if (!target.offsetWidth) return;

      const [{ jsPDF }, html2canvasMod] = await Promise.all([
        import("jspdf"),
        import("html2canvas-pro"),
      ]);
      const html2canvas = html2canvasMod.default;

      // Force the light theme for capture by cloning into an off-screen wrapper
      // with data-theme="cmyk". daisyUI scopes theme CSS variables to
      // [data-theme], so every bg-base-*/text-base-content class inside resolves
      // to the light palette — the PDF is always print-friendly even when the
      // visitor is in dark ("night") mode.
      wrapper = document.createElement("div");
      wrapper.setAttribute("data-theme", "cmyk");
      wrapper.setAttribute("data-pdf-render", "true");
      wrapper.style.position = "fixed";
      wrapper.style.left = "-99999px";
      wrapper.style.top = "0";
      wrapper.style.width = `${target.offsetWidth}px`;
      wrapper.style.pointerEvents = "none";
      wrapper.appendChild(target.cloneNode(true));
      document.body.appendChild(wrapper);
      // Paint the wrapper itself with the current bg-base-200 so the canvas
      // has an opaque bg matching the resume — no pure-white gaps in the PDF.
      // Used both as the wrapper fill and as the per-slice pre-fill color
      // further below.
      const pdfBgColor =
        getComputedStyle(wrapper).getPropertyValue("--color-base-200").trim() || "#eaeaeb";
      wrapper.style.background = pdfBgColor;

      // Cap the render scale so tall resumes don't blow past browser canvas
      // dimension/area limits (~32kpx). 2x is plenty for crisp text.
      const scale = Math.min(2, 4000 / target.offsetHeight);

      const canvas = await html2canvas(wrapper, {
        scale,
        useCORS: true,
        logging: false,
        // No backgroundColor override — the wrapper's bg (set above) covers
        // the canvas; per-slice bg pre-fills prevent transparent source
        // regions from rendering as PDF white.
        ignoreElements: (el) => Boolean(el.classList?.contains("pdf-exclude")),
      });

      const pdf = new jsPDF({ orientation: "portrait", unit: "pt", format: "letter" });
      const pageWidth = pdf.internal.pageSize.getWidth();
      const pageHeight = pdf.internal.pageSize.getHeight();
      const imgWidth = pageWidth;
      // Full-bleed page slicing (no margins): every PDF page is filled edge
      // to edge by the resume. pageHeightCanvas is one page's worth of
      // source-canvas pixels at full letter height; addImage is positioned
      // at (0,0) so content starts at the top of the paper.
      const pageHeightCanvas = Math.floor((pageHeight * canvas.width) / pageWidth);

      // Fixed-height slicing: the two-column layout has independent left and
      // right column heights, so content-aware grouping causes large white
      // gaps when one column ends before the other. Slicing at fixed page
      // heights guarantees each page is filled edge-to-edge with continuous
      // content and the resume background color.
      const pageGroups: { startY: number; endY: number }[] = [];
      let y = 0;
      while (y < canvas.height) {
        const sliceHeight = Math.min(pageHeightCanvas, canvas.height - y);
        pageGroups.push({ startY: y, endY: y + sliceHeight });
        y += sliceHeight;
      }

      // Render each page group as a slice. Pre-fill the slice canvas with
      // the resume bg color BEFORE drawing the source so any transparent
      // region (column gap, padding, area outside cloned tree) renders as
      // bg-base-200 instead of pure PDF white.
      for (let pageNum = 0; pageNum < pageGroups.length; pageNum++) {
        if (pageNum > 0) pdf.addPage();
        const { startY, endY } = pageGroups[pageNum];
        const sliceHeight = endY - startY;
        const sliceCanvas = document.createElement("canvas");
        sliceCanvas.width = canvas.width;
        sliceCanvas.height = sliceHeight;
        const ctx = sliceCanvas.getContext("2d");
        if (ctx) {
          ctx.fillStyle = pdfBgColor;
          ctx.fillRect(0, 0, canvas.width, sliceHeight);
          ctx.drawImage(
            canvas,
            0,
            startY,
            canvas.width,
            sliceHeight,
            0,
            0,
            canvas.width,
            sliceHeight,
          );
        }
        const sliceData = sliceCanvas.toDataURL("image/png");
        const sliceImgHeight = (sliceHeight * imgWidth) / canvas.width;
        pdf.addImage(sliceData, "PNG", 0, 0, imgWidth, sliceImgHeight);
      }

      pdf.save("Dan-Maas-Resume.pdf");
    } catch (err) {
      console.error("Failed to generate resume PDF:", err);
      window.alert("Sorry, something went wrong generating the PDF. Please try again.");
    } finally {
      pdfBusy = false;
      btn.disabled = false;
      if (icon) icon.style.display = "";
      if (spinner) spinner.style.display = "none";
      if (label) label.textContent = originalText;
      if (wrapper?.parentNode) wrapper.parentNode.removeChild(wrapper);
    }
  }

  function wirePdfButton() {
    const btn = document.getElementById("download-pdf-btn");
    if (btn && !btn.dataset.wired) {
      btn.addEventListener("click", downloadResumePdf);
      btn.dataset.wired = "true";
    }
  }

  document.addEventListener("astro:page-load", wirePdfButton);
</script>
