---
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  profileAbout,
  profileTagline,
  resumeCertifications,
  resumeContact,
  resumeEducation,
  resumeExperience,
  resumeHobbies,
  resumeLanguages,
  resumePublications,
  resumeSkills,
  resumeStrengths,
} from "src/lib/profile";

const about = profileAbout;
const strengths = resumeStrengths;
const contact = resumeContact;
const skills = resumeSkills;
const experience = resumeExperience;
const education = resumeEducation;
const certifications = resumeCertifications;
const publications = resumePublications;
const languages = resumeLanguages;
const hobbies = resumeHobbies;

const resumeDescription = `Dan Maas — ${profileTagline}. Resume and professional experience.`;
---

<BaseLayout title="Resume — Dan Maas" description={resumeDescription} activeLink="">
  <div class="min-h-screen bg-base-200">
    <!-- Header banner -->
    <div class="bg-base-300 border-b border-base-content/10">
      <div class="px-6 py-8 md:px-12">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
          <div class="min-w-0">
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight">Dan Maas</h1>
            <p class="text-base md:text-lg text-base-content/70 mt-1.5">{profileTagline}</p>
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 md:hidden text-sm text-base-content/70">
              {contact.map((c) => (
                c.href ? (
                  <a href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined} class="link link-hover link-primary">
                    {c.value}
                  </a>
                ) : (
                  <span>{c.value}</span>
                )
              ))}
            </div>
          </div>
          <div class="flex flex-col items-start md:items-end gap-4 shrink-0">
            <a
              href="/docs/Daniel_Maas_Resume.pdf"
              download="Dan-Maas-Resume.pdf"
              class="btn btn-primary btn-sm gap-2 shadow-sm"
              aria-label="Download resume as PDF"
            >
              <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
              Download PDF
            </a>
            <ul class="text-sm space-y-1.5 text-left md:text-right">
              {contact.map((c) => (
                <li class="flex items-baseline gap-3 md:justify-end">
                  <span class="text-[10px] uppercase tracking-widest text-base-content/40 font-semibold shrink-0 md:w-20 md:text-right">{c.label}</span>
                  {c.href ? (
                    <a
                      href={c.href}
                      target={c.href.startsWith("http") ? "_blank" : undefined}
                      rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                      class="text-base-content/80 hover:text-primary transition-colors break-all"
                    >
                      {c.value}
                    </a>
                  ) : (
                    <span class="text-base-content/80">{c.value}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Main content -->
    <div class="px-6 md:px-12 py-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Left column: About, Strengths, Skills, Education, Certifications, Publications, Languages -->
        <aside class="lg:w-80 shrink-0">
          <div class="space-y-6">
            <section class="bg-base-100 rounded-box p-6 shadow-sm">
              <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-4">About</h2>
              <p class="text-sm text-base-content/80 leading-relaxed">{about}</p>
            </section>

            <section class="bg-base-100 rounded-box p-6 shadow-sm">
              <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-4">Strengths</h2>
              <ul class="space-y-1.5 text-sm text-base-content/80">
                {strengths.map((s) => (
                  <li class="flex items-start gap-2">
                    <span class="text-primary mt-0.5">◆</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </section>

            <section class="bg-base-100 rounded-box p-6 shadow-sm">
              <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-4">Skills</h2>
              <div class="flex flex-wrap gap-2">
                {skills.map((s) => (
                  <span class="resume-pill inline-flex items-center px-3 py-1 text-sm font-medium text-base-content rounded-full border-[1.5px] border-base-content/40">{s}</span>
                ))}
              </div>
            </section>

            <section class="bg-base-100 rounded-box p-6 shadow-sm">
              <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-4">Education</h2>
              <div class="space-y-4">
                {education.map((e) => (
                  <div>
                    <p class="font-semibold">{e.degree}</p>
                    <p class="text-sm text-base-content/70">{e.school}</p>
                    <p class="text-sm text-base-content/70">{e.dates}</p>
                  </div>
                ))}
              </div>
            </section>

            <section class="bg-base-100 rounded-box p-6 shadow-sm">
              <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-4">Certifications</h2>
              <ul class="space-y-2">
                {certifications.map((c) => (
                  <li class="font-semibold">{c}</li>
                ))}
              </ul>
            </section>

            <section class="bg-base-100 rounded-box p-6 shadow-sm">
              <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-4">Publications</h2>
              <ul class="list-disc pl-5 space-y-1.5 text-base-content/80">
                {publications.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </section>

            <section class="bg-base-100 rounded-box p-6 shadow-sm">
              <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-4">Languages</h2>
              <div class="flex flex-wrap gap-2">
                {languages.map((l) => (
                  <span class="resume-pill inline-flex items-center px-3 py-1 text-sm font-medium text-base-content rounded-full border-[1.5px] border-base-content/40">{l.level ? `${l.name} · ${l.level}` : l.name}</span>
                ))}
              </div>
            </section>
          </div>
        </aside>

        <!-- Right column: Work History -->
        <div class="flex-1 min-w-0">
          <section class="bg-base-100 rounded-box p-6 shadow-sm">
            <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-6">Experience</h2>

            <div class="space-y-8">
              {experience.map((job) => (
                <div>
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                    <h3 class="text-xl font-bold">{job.title}</h3>
                    <span class="text-sm text-base-content/50 whitespace-nowrap">{job.dates}</span>
                  </div>
                  <p class="text-base font-medium text-base-content/80 mb-1">{job.company}</p>
                  {job.location && <p class="text-sm text-base-content/50 mb-2">{job.location}</p>}

                  {job.description && (
                    <p class="text-base-content/80 mb-2 leading-relaxed">{job.description}</p>
                  )}

                  {job.bullets && (
                    <ul class="list-disc pl-5 space-y-1.5 text-base-content/80">
                      {job.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}

                  {job.subRoles && (
                    <div class="space-y-4 mt-2">
                      {job.subRoles.map((sr) => (
                        <div>
                          <p class="font-semibold text-base-content/90 mb-1">{sr.title}</p>
                          <ul class="list-disc pl-5 space-y-1.5 text-base-content/80">
                            {sr.bullets.map((b) => (
                              <li>{b}</li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>

          <section class="bg-base-100 rounded-box p-6 shadow-sm mt-6">
            <h2 class="text-lg font-bold uppercase tracking-wider text-base-content/60 mb-4">Miscellaneous</h2>
            <p class="font-semibold mb-2">Hobbies</p>
            <p class="text-base-content/80">{hobbies}</p>
          </section>

          <footer class="text-center py-8">
            <div class="inline-flex items-center gap-2 bg-base-300/50 border border-base-content/10 rounded-full px-5 py-2.5">
              <svg class="w-5 h-5 text-base-content/40 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
              <span class="text-sm text-base-content/60">Visitor # <span id="visitor-counter" class="font-mono font-bold tabular-nums text-base-content">—</span></span>
            </div>
          </footer>
        </div>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  let isProcessing = false;

  async function fetchCounter() {
    const counterEl = document.getElementById("visitor-counter");
    if (!counterEl || isProcessing) return;

    isProcessing = true;
    counterEl.className = "font-mono font-bold tabular-nums transition-all duration-500 text-base-content";

    try {
      const response = await fetch("https://api.drmaas.me/resume/increment", {
        method: "POST",
        headers: { Accept: "application/json", "Content-Type": "application/json" },
        body: JSON.stringify({}),
      });

      if (!response.ok) {
        throw new Error(`counter request failed: ${response.status}`);
      }

      const data = await response.json();
      const target = data.counter;
      if (typeof target !== "number" || !Number.isFinite(target)) {
        throw new Error("counter response missing numeric counter");
      }

      let current = 0;
      const step = Math.max(1, Math.floor(target / 25));
      const tick = () => {
        current = Math.min(current + step, target);
        counterEl.textContent = current.toLocaleString();
        if (current < target) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    } catch {
      counterEl.textContent = "—";
      counterEl.className = "font-mono tabular-nums text-base-content/20";
    } finally {
      isProcessing = false;
    }
  }

  // astro:page-load fires after every navigation (including the first page load)
  // when ClientRouter is active — this is the correct hook to use.
  document.addEventListener("astro:page-load", fetchCounter);
</script>
