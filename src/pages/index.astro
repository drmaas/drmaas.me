---
import ArticleCard from "@components/ArticleCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import config from "src/config";
import { sortDateDescending } from "src/misc";
import { getPublishedPosts } from "src/lib/published-posts";

const posts = sortDateDescending(await getPublishedPosts()).slice(0, 3);
const { fullName } = config.metaData;

const heroIntro =
  "I've been deep in the agentic AI space — building and orchestrating coding agents (Claude Code, Cursor, Codex) and authoring the primitives that power them: MCP servers, plugins, skills, hooks, and subagents.";

const heroTagline = "Software Shepherd · Agentic AI · AWS · Cloudflare";

const heroSkills = [
  "Agentic AI",
  "Application Architecture",
  "Cloudflare",
  "MCP Servers",
  "System Design",
  "TypeScript",
];
---

<BaseLayout title="Home" activeLink="home">
	<section
		class="max-w-6xl mx-auto mb-16 mt-4 px-4"
		aria-labelledby="home-hero-heading"
	>
		<div
			class="flex flex-col items-center gap-8 rounded-box border border-base-content/10 bg-base-200/60 p-6 shadow-sm sm:p-8 md:flex-row md:items-start md:gap-10"
		>
			<picture>
				<source
					srcset="/images/profile-hero.webp"
					type="image/webp"
				/>
				<img
					src="/images/profile-hero.jpg"
					alt={`${fullName} — software engineer`}
					width="512"
					height="512"
					class="aspect-square w-32 shrink-0 rounded-full object-cover ring-2 ring-primary/25 shadow-md sm:w-40 md:w-48"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</picture>
			<div class="min-w-0 flex-1 text-center md:text-left">
				<h1
					id="home-hero-heading"
					class="text-3xl font-bold tracking-tight sm:text-4xl"
				>
					{fullName}
				</h1>
				<p class="mt-2 text-sm text-base-content/80 sm:text-base">
					{heroTagline}
				</p>
				<p class="mt-4 text-base leading-relaxed text-base-content/80">
					{heroIntro}
				</p>
				<ul
					class="mt-5 flex flex-wrap justify-center gap-2 md:justify-start"
					aria-label="Highlighted skills"
				>
					{
						heroSkills.map((skill) => (
							<li>
								<span class="inline-flex items-center rounded-full border-[1.5px] border-base-content/40 px-3 py-1 text-sm font-medium text-base-content">
									{skill}
								</span>
							</li>
						))
					}
				</ul>
				<div
					class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start"
				>
					<a href="/resume/" class="btn btn-primary shadow-sm">
						View Resume
					</a>
					<a href="/about/" class="btn btn-outline btn-primary">
						About Me
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="max-w-6xl mx-auto mb-32 px-4">
		<h2 class="text-center mb-6 text-3xl font-bold sm:text-4xl">Featured Articles</h2>

		<div class="flex flex-col justify-center gap-8">
			{posts.map((post) => (
				<ArticleCard content={post} headingLevel={3} />
			))}

			<a
				href="/articles/"
				class="btn btn-primary btn-lg mx-auto mt-4 shadow-lg hover:shadow-xl transition-shadow duration-200"
			>
				<span>View All Articles</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-6 w-6"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>
	</section>
</BaseLayout>
